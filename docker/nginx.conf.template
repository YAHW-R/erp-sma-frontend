server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Los extractos bancarios pueden pesar varios MB.
  client_max_body_size 20m;

  # La API va por el mismo origen que la app: sin CORS y sin URLs absolutas.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  location /healthz {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
  }

  # SPA: cualquier ruta desconocida devuelve el index y React Router decide.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Los archivos con hash se pueden cachear para siempre; el index no.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }
}
